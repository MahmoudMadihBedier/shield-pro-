# Copy to `.env.local` (git-ignored). Holds SECRETS — never commit this file.

# Supabase project ref + Postgres connection (used by the Supabase CLI:
# `supabase db push`, `supabase functions deploy`). Dashboard → Project
# Settings → Database / API.
SUPABASE_PROJECT_REF=""
SUPABASE_DB_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[REF].supabase.co:5432/postgres"
SUPABASE_DB_PASSWORD=""

# Service-role key — full DB access, bypasses RLS. Server / CLI / migration
# scripts only, NEVER shipped to the browser. Dashboard → Project Settings →
# API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""
