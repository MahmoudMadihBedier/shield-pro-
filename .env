# Appwrite client configuration for Shield Pro.
#
# These three values are NON-SECRET public client config (they are shipped in the
# browser bundle by design, exactly like a Firebase config object). They are
# committed on purpose so the app builds anywhere without extra setup.
#
# Anything that is actually secret (Appwrite API keys for Functions / CI, OAuth
# secrets, etc.) MUST go in `.env.local`, which is git-ignored.

VITE_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="6a95b631003d4163dc97"
VITE_APPWRITE_PROJECT_NAME="shield-pro"
